generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id          Int        @id @default(autoincrement())
  property_id Int
  due_date    DateTime   @db.Date
  amount      Decimal    @db.Decimal(12, 2)
  paid_at     DateTime?  @db.Timestamp(6)
  status      String     @default("PENDING") @db.VarChar(30)
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_property")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model properties {
  id                                Int        @id @default(autoincrement())
  address                           String     @db.VarChar(255)
  description                       String?
  monthly_rent                      Decimal    @db.Decimal(12, 2)
  status                            String     @default("AVAILABLE") @db.VarChar(30)
  agent_id                          Int?
  client_id                         Int?
  rental_start_date                 DateTime?  @db.Date
  rental_end_date                   DateTime?  @db.Date
  created_at                        DateTime   @default(now()) @db.Timestamp(6)
  payments                          payments[]
  users_properties_agent_idTousers  users?     @relation("properties_agent_idTousers", fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_property_agent")
  users_properties_client_idTousers users?     @relation("properties_client_idTousers", fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_property_client")
}

model roles {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String?
  active      Boolean @default(true)
  users       users[]
}

model users {
  id                                     Int          @id @default(autoincrement())
  name                                   String       @db.VarChar(100)
  email                                  String       @unique @db.VarChar(150)
  password                               String       @db.VarChar(255)
  role_id                                Int
  active                                 Boolean      @default(true)
  created_at                             DateTime     @default(now()) @db.Timestamp(6)
  properties_properties_agent_idTousers  properties[] @relation("properties_agent_idTousers")
  properties_properties_client_idTousers properties[] @relation("properties_client_idTousers")
  roles                                  roles        @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_role")
}
