generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model roles {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?
  active      Boolean  @default(true)

  users users[]
}

model users {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @db.VarChar(255)
  role_id    Int
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)

  role roles @relation(fields: [role_id], references: [id])

  ownedProperties properties[] @relation("property_owner")
  agentProperties properties[] @relation("property_agent")

  rentalContracts rental_contracts[] @relation("tenant_contracts")
}

model properties {
  id           Int      @id @default(autoincrement())
  address      String   @db.VarChar(255)
  description  String?
  monthly_rent Decimal  @db.Decimal(12, 2)

  status String @default("AVAILABLE") @db.VarChar(30)

  owner_id Int?
  agent_id Int?

  created_at DateTime @default(now()) @db.Timestamp(6)

  owner users? @relation("property_owner", fields: [owner_id], references: [id])
  agent users? @relation("property_agent", fields: [agent_id], references: [id])

  contracts rental_contracts[]
  images    property_images[]
}

model property_images {
  id          Int      @id @default(autoincrement())
  property_id Int

  url         String   @db.VarChar(500)
  public_id   String   @db.VarChar(255)

  created_at  DateTime @default(now()) @db.Timestamp(6)

  property properties @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@index([property_id])
}

model rental_contracts {
  id          Int       @id @default(autoincrement())

  property_id Int
  tenant_id   Int

  start_date DateTime  @db.Date
  end_date   DateTime? @db.Date

  monthly_rent Decimal @db.Decimal(12, 2)

  status String @default("ACTIVE") @db.VarChar(30)

  created_at DateTime @default(now()) @db.Timestamp(6)

  property properties @relation(fields: [property_id], references: [id])
  tenant   users      @relation("tenant_contracts", fields: [tenant_id], references: [id])

  payments payments[]
}

model payments {
  id Int @id @default(autoincrement())

  contract_id Int

  due_date DateTime @db.Date
  amount   Decimal  @db.Decimal(12, 2)

  paid_at DateTime? @db.Timestamp(6)

  status String @default("PENDING") @db.VarChar(30)

  created_at DateTime @default(now()) @db.Timestamp(6)

  contract rental_contracts @relation(fields: [contract_id], references: [id])
}